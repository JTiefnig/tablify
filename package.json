{
  "name": "tablify",
  "displayName": "Tablify",
  "description": "Open JSON, YAML, CSV and log files as interactive, filterable tables. Edit cells in place and see git changes and blame per entry.",
  "version": "0.2.0",
  "publisher": "JohannesTiefnig",
  "icon": "media/tablify-icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "license": "MIT",
  "pricing": "Free",
  "homepage": "https://github.com/JTiefnig/tablify#readme",
  "bugs": {
    "url": "https://github.com/JTiefnig/tablify/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/JTiefnig/tablify"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "json",
    "yaml",
    "csv",
    "tsv",
    "table",
    "grid",
    "viewer",
    "editor",
    "json viewer",
    "yaml viewer",
    "csv viewer",
    "json table",
    "data viewer",
    "filter",
    "git blame",
    "log",
    "log viewer",
    "syslog",
    "jsonl",
    "ndjson",
    "requirements"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "On-save commands from .vscode/tablify.yaml only run in trusted workspaces."
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "tablify.tableView",
        "displayName": "Tablify Table",
        "selector": [
          {
            "filenamePattern": "*.json"
          },
          {
            "filenamePattern": "*.yaml"
          },
          {
            "filenamePattern": "*.yml"
          },
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "tablify.logView",
        "displayName": "Log Table",
        "selector": [
          {
            "filenamePattern": "*.log"
          },
          {
            "filenamePattern": "*.log.[0-9]*"
          },
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          },
          {
            "filenamePattern": "**/access_log*"
          },
          {
            "filenamePattern": "**/error_log*"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "tablify.openAsTable",
        "title": "Open as Table",
        "category": "Tablify",
        "icon": "$(table)"
      },
      {
        "command": "tablify.openAsText",
        "title": "Open as Text",
        "category": "Tablify",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tablify.filter",
        "title": "Filter Rows",
        "category": "Tablify",
        "icon": "$(filter)"
      },
      {
        "command": "tablify.clearFilter",
        "title": "Clear Filter",
        "category": "Tablify",
        "icon": "$(filter-filled)"
      },
      {
        "command": "tablify.saveFilter",
        "title": "Save Filter…",
        "category": "Tablify",
        "icon": "$(bookmark)"
      },
      {
        "command": "tablify.saveView",
        "title": "Save View…",
        "category": "Tablify",
        "icon": "$(save)"
      },
      {
        "command": "tablify.resetView",
        "title": "Reset View",
        "category": "Tablify",
        "icon": "$(discard)"
      },
      {
        "command": "tablify.openAsLogTable",
        "title": "Open as Log Table",
        "category": "Tablify",
        "icon": "$(table)"
      },
      {
        "command": "tablify.selectLogFormat",
        "title": "Log Table: Select Format",
        "category": "Tablify"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "tablify.openAsTable",
          "when": "resourceExtname =~ /^\\.(json|ya?ml|csv|tsv)$/i",
          "group": "navigation@20"
        },
        {
          "command": "tablify.openAsLogTable",
          "when": "!explorerResourceIsFolder && resourceFilename =~ /(\\.(log|jsonl|ndjson|out|txt)(\\.[0-9]+)?|_log.*)$|^[^.]+$/i",
          "group": "navigation@21"
        }
      ],
      "editor/title": [
        {
          "command": "tablify.openAsTable",
          "when": "resourceExtname =~ /^\\.(json|ya?ml|csv|tsv)$/i && activeCustomEditorId != tablify.tableView",
          "group": "navigation"
        },
        {
          "command": "tablify.openAsLogTable",
          "when": "(editorLangId == log || resourceExtname =~ /^\\.(jsonl|ndjson)$/i) && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "tablify.openAsText",
          "when": "activeCustomEditorId == tablify.tableView || activeCustomEditorId == tablify.logView",
          "group": "navigation"
        },
        {
          "command": "tablify.filter",
          "when": "activeCustomEditorId == tablify.tableView && !tablify.filterActive || activeCustomEditorId == tablify.logView && !tablify.logFilterActive",
          "group": "navigation@1"
        },
        {
          "command": "tablify.clearFilter",
          "when": "activeCustomEditorId == tablify.tableView && tablify.filterActive || activeCustomEditorId == tablify.logView && tablify.logFilterActive",
          "group": "navigation@1"
        },
        {
          "command": "tablify.saveView",
          "when": "activeCustomEditorId == tablify.tableView && tablify.layoutModified",
          "group": "navigation@2"
        },
        {
          "command": "tablify.saveView",
          "when": "activeCustomEditorId == tablify.tableView",
          "group": "1_tablify@1"
        },
        {
          "command": "tablify.resetView",
          "when": "activeCustomEditorId == tablify.tableView && tablify.layoutModified",
          "group": "1_tablify@2"
        },
        {
          "command": "tablify.saveFilter",
          "when": "activeCustomEditorId == tablify.tableView && tablify.filterActive",
          "group": "1_tablify@3"
        },
        {
          "command": "tablify.selectLogFormat",
          "when": "activeCustomEditorId == tablify.logView",
          "group": "1_tablify@4"
        }
      ],
      "editor/title/context": [
        {
          "command": "tablify.openAsTable",
          "when": "resourceExtname =~ /^\\.(json|ya?ml|csv|tsv)$/i",
          "group": "3_open"
        },
        {
          "command": "tablify.openAsLogTable",
          "group": "3_open"
        }
      ],
      "commandPalette": [
        {
          "command": "tablify.openAsTable",
          "when": "resourceExtname =~ /^\\.(json|ya?ml|csv|tsv)$/i"
        },
        {
          "command": "tablify.openAsText",
          "when": "activeCustomEditorId == tablify.tableView || activeCustomEditorId == tablify.logView"
        },
        {
          "command": "tablify.filter",
          "when": "activeCustomEditorId == tablify.tableView || activeCustomEditorId == tablify.logView"
        },
        {
          "command": "tablify.clearFilter",
          "when": "activeCustomEditorId == tablify.tableView && tablify.filterActive || activeCustomEditorId == tablify.logView && tablify.logFilterActive"
        },
        {
          "command": "tablify.saveFilter",
          "when": "activeCustomEditorId == tablify.tableView && tablify.filterActive"
        },
        {
          "command": "tablify.saveView",
          "when": "activeCustomEditorId == tablify.tableView"
        },
        {
          "command": "tablify.resetView",
          "when": "activeCustomEditorId == tablify.tableView && tablify.layoutModified"
        },
        {
          "command": "tablify.openAsLogTable"
        },
        {
          "command": "tablify.selectLogFormat",
          "when": "activeCustomEditorId == tablify.logView"
        }
      ]
    },
    "configuration": {
      "title": "Tablify",
      "properties": {
        "tablify.idField": {
          "type": "string",
          "default": "id",
          "description": "Field name used for the ID column of hash files (the key of each entry)."
        },
        "tablify.git.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show which rows changed since the last commit (change bar) and git blame per entry for files in a git repository."
        },
        "tablify.saveWithoutFormatting": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Save from the table view with **Save without Formatting**, so format-on-save, trim whitespace and other save actions do not rewrite entries the table did not change. Applies to the Ctrl/Cmd+S shortcut."
        },
        "tablify.log.customFormats": {
          "type": "array",
          "default": [],
          "markdownDescription": "Additional log formats: a JavaScript regex with named groups per format. They take part in format detection like the built-in formats and win ties. Invalid patterns are reported and skipped.",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique ID of the format."
              },
              "label": {
                "type": "string",
                "description": "Name shown in the format picker and the status bar."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "regex",
                  "jsonl",
                  "logfmt"
                ],
                "default": "regex",
                "markdownDescription": "How entries are read: a regex with named groups (needs `pattern`), JSON Lines or logfmt."
              },
              "pattern": {
                "type": "string",
                "markdownDescription": "JavaScript regex with named groups, e.g. `^(?<timestamp>\\S+) (?<level>[A-Z]+) (?<message>.*)$`. Applied to the first line of each entry."
              },
              "roles": {
                "type": "object",
                "markdownDescription": "Group name → role. Groups named `timestamp`, `level` and `message` get that role by default.",
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "timestamp",
                    "level",
                    "message",
                    "source",
                    "none"
                  ]
                }
              },
              "multiline": {
                "type": "boolean",
                "default": true,
                "description": "Lines that do not match continue the previous entry (stack traces)."
              },
              "timestampFormat": {
                "type": "string",
                "description": "Hint for the timestamp format (informational)."
              },
              "postProcess": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "syslog-pri",
                    "split-http-request",
                    "status-level",
                    "nil-dash",
                    "sd-params"
                  ]
                },
                "description": "Built-in enrichers to apply."
              }
            }
          }
        },
        "tablify.log.detectionSampleLines": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Number of non-empty lines from the start of a log file used to detect its format."
        },
        "tablify.log.detectionThreshold": {
          "type": "number",
          "default": 0.6,
          "minimum": 0,
          "maximum": 1,
          "description": "Share of sampled lines a format must match to be detected; otherwise the file is shown as plain text."
        },
        "tablify.log.largeFileThresholdMB": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "description": "Log files above this size ask whether to load all of them or only the first or last lines."
        },
        "tablify.log.defaultHiddenColumns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ident",
            "version",
            "tid"
          ],
          "description": "Log table columns hidden by default. Columns that are always empty or \"-\" are hidden as well."
        }
      }
    },
    "keybindings": [
      {
        "command": "tablify.filter",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == tablify.tableView || activeCustomEditorId == tablify.logView"
      },
      {
        "command": "workbench.action.files.saveWithoutFormatting",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == tablify.tableView && config.tablify.saveWithoutFormatting"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/.vscode/tablify.json",
        "url": "./schemas/tablify.schema.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "**/.vscode/tablify.yaml",
          "**/.vscode/tablify.yml"
        ],
        "url": "./schemas/tablify.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run check && node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check": "tsc -p . --noEmit && tsc -p webview --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "package": "vsce package --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/tabulator-tables": "^6.3.6",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "jsonc-parser": "^3.3.1",
    "tabulator-tables": "^6.6.1",
    "yaml": "^2.9.1"
  }
}
